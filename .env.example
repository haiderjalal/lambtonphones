SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# At least 32 random characters, e.g. `openssl rand -hex 32`. Used to hash IP addresses for rate limiting.
IP_HASH_SECRET=

# Enquiry email notifications (optional; enquiries are saved even when these are unset)
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
ENQUIRY_FROM_EMAIL=
